{
  "Print": {
    "prefix": "print",
    "body": ["print(${1:\"hi\"})"],
    "description": "Print values"
  },
  "Function": {
    "prefix": "fn",
    "body": ["fn ${1:name}(${2:args}) {", "    ${3:return $2}", "}"],
    "description": "New function"
  },
  "For in": {
    "prefix": "forin",
    "body": ["for ${1:item} in ${2:arr} {", "    ${3:print($1)}", "}"],
    "description": "For-in loop"
  },
  "For classic": {
    "prefix": "fori",
    "body": ["for ${1:i} := 0; ${1:i} < ${2:3}; ${1:i} = ${1:i} + 1 {", "    ${3:print($1)}", "}"],
    "description": "Classic for loop"
  },
  "If else": {
    "prefix": "if",
    "body": ["if ${1:x > 0} {", "    ${2:print(\"yes\")}", "} else {", "    ${3:print(\"no\")}", "}"],
    "description": "If/else branch"
  },
  "Struct": {
    "prefix": "struct",
    "body": ["struct ${1:Player} {", "    ${2:name} ${3:hp}", "}"],
    "description": "Struct definition"
  },
  "HTTP server": {
    "prefix": "server",
    "body": [
      "fn hello(req) {",
      "    if req[\"path\"] == \"/hi\" {",
      "        return \"hi there\"",
      "    }",
      "    return {\"status\": 404, \"body\": \"try /hi\"}",
      "}",
      "http_listen(${1:8080}, hello)"
    ],
    "description": "Tiny web server"
  },
  "Try catch": {
    "prefix": "try",
    "body": ["try {", "    ${1:risky()}", "} catch ${2:e} {", "    print($2)", "}"],
    "description": "Catch runtime errors"
  }
}
