// Log analyzer: reads a log file (arg or app.log), counts levels,
// ranks unique errors, writes report.txt.
file := "app.log"
if len(args()) > 0 {
    file = args()[0]
}
log := read_file(file)
lines := split(log, "\n")

total := 0
levels := {}
errs := {}

for line in lines {
    if len(line) == 0 {
        continue
    }
    total = total + 1
    lv := "INFO"
    if contains(line, "ERROR") {
        lv = "ERROR"
    } else if contains(line, "WARN") {
        lv = "WARN"
    }
    if has(levels, lv) {
        levels[lv] = levels[lv] + 1
    } else {
        levels[lv] = 1
    }
    if lv == "ERROR" {
        // group by message text without timestamp
        key := line
        parts := split(line, "ERROR")
        if len(parts) > 1 {
            key = parts[1]
        }
        if has(errs, key) {
            errs[key] = errs[key] + 1
        } else {
            errs[key] = 1
        }
    }
}

print("file: ", file)
print("total: ", total)
print("levels: ", levels)
print("--- unique errors ---")
for k in keys(errs) {
    print(errs[k], "x ", k)
}

report := "log report: " + file + "\n"
report = report + "total: " + str(total) + "\n"
for k in keys(levels) {
    report = report + k + ": " + str(levels[k]) + "\n"
}
for k in keys(errs) {
    report = report + str(errs[k]) + "x " + k + "\n"
}
write_file("report.txt", report)
print("report saved: ", exists("report.txt"))
