struct Boss {
    id
    hp
    shield
}

// Boss soaks damage with his shield first, then takes hp hits.
b := Boss{777, 1000, 300}
print("Boss spawned, shields: ", b.shield)

// every enemy is [id, hp]
enemies := [[0, 60], [1, 80], [2, 100]]
print("waves: ", len(enemies))

round := 0
alive := len(enemies)
while alive > 0 {
    round = round + 1
    alive = 0
    for i := 0; i < len(enemies); i = i + 1 {
        if enemies[i][1] > 0 {
            enemies[i][1] = enemies[i][1] - 40
        }
        if enemies[i][1] > 0 {
            alive = alive + 1
        }
    }
    print("round ", round, " alive ", alive)
}

b.hp = b.hp + b.shield - 500
b.shield = 0
print("boss hp: ", b.hp)
print("victory in ", round, " rounds")
