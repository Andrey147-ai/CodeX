// Grade book: structs, methods, arrays, maps, files.
// Struct: a student with a name and score list.
struct Student {
    name
    scores
}
// Method: average score (for-in sum divided by count).
fn (s Student) avg() {
    total := 0
    for x in s.scores {
        total = total + x
    }
    return total / len(s.scores)
}
// Function: average score to letter grade.
fn grade(a) {
    if a >= 90 {
        return "A"
    } else if a >= 75 {
        return "B"
    } else if a >= 60 {
        return "C"
    } else {
        return "F"
    }
}
// Group: array of structs (each with its own score list).
group := [Student {"Ann", [90, 85, 95]}, Student {"Bob", [70, 60, 80]}, Student {"Cat", [100, 95, 90]}]
// Report map: name -> grade. best/bestAvg track the top student.
best := ""
bestAvg := 0
report := {}
for s in group {
    a := s.avg() // struct method call
    g := grade(a) // plain function call
    print(s.name, " avg=", a, " grade=", g)
    report[s.name] = g // map write by key
    if a > bestAvg {
        bestAvg = a
        best = s.name
    }
}
// Totals: top student and the whole map.
print("best: ", best, " (", bestAvg, ")")
print(report)
// Save: map keys joined by comma -> file -> verify by reading.
write_file("grades.txt", join(keys(report), ","))
print("saved: ", read_file("grades.txt"))
