// Guess the number in 20 lines — a beginner's first game.
// Run: ..\codex.exe guess.cx
secret := randint(1, 100)
tries := 0
print("I picked 1..100. Can you guess it?")
while true {
    guess := num(input("Your try: "))
    tries += 1
    if guess == secret {
        print("Nailed it! " + str(secret) + " in " + str(tries) + " tries")
        break
    } else if guess < secret {
        print("Go higher")
    } else {
        print("Go lower")
    }
}
