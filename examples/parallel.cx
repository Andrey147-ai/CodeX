// Parallel workers: square numbers in background tasks,
// gather results through a channel.
fn square(n) {
    return n * n
}
tasks := []
for n in range(1, 6) {
    push(tasks, spawn(square, n))
}
total := 0
for t in tasks {
    total += wait(t)
}
print("sum of squares: ", total)
// producer + consumer through a buffered channel
ch := channel(3)
fn producer(ch) {
    for i in range(3) {
        send(ch, "msg" + str(i))
    }
}
p := spawn(producer, ch)
for i in range(3) {
    print("got ", recv(ch))
}
wait(p)
