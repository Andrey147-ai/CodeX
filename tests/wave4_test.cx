// Wave 4: files/paths, string affixes, clamp, sorted, zip.
write_file("w4_src.txt", "abc")
assert(copy_file("w4_src.txt", "w4_dst.txt") == 3, "copy_file bytes")
assert(read_file("w4_dst.txt") == "abc", "copy_file content")
assert(basename("a/b/c.txt") == "c.txt", "basename")
assert(trim_prefix("hello", "he") == "llo", "trim_prefix")
assert(trim_prefix("hello", "zz") == "hello", "trim_prefix miss")
assert(trim_suffix("hello", "lo") == "hel", "trim_suffix")
assert(pad_left("7", 3) == "  7", "pad_left")
assert(pad_right("7", 3, "0") == "700", "pad_right ch")
assert(clamp(5, 1, 10) == 5, "clamp mid")
assert(clamp(-1, 1, 10) == 1, "clamp lo")
assert(clamp(99, 1, 10) == 10, "clamp hi")
orig := [3, 1, 2]
cp := sorted(orig)
assert(cp == [1, 2, 3], "sorted copy")
assert(orig == [3, 1, 2], "sorted keeps orig")
assert(zip([1, 2], ["a", "b"]) == [[1, "a"], [2, "b"]], "zip")
assert(zip([1, 2, 3], ["a"]) == [[1, "a"]], "zip short")
assert(len(join_path("a", "b")) > 2, "join_path")
