// Site preview on CodeX itself: serves site/ over HTTP.
// Run from repo root: ..\codex.exe site\serve.cx → http://127.0.0.1:8090/
fn site(req) {
    path := req["path"]
    if path == "/" {
        path = "/index.html"
    }
    body := read_file("site" + path)
    return {"status": 200, "body": body}
}
print("site on 127.0.0.1:8090")
http_listen(8090, site)
